{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile and app settings record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "isPro": { "type": "boolean" },
        "theme": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "automationTask": {
      "title": "AutomationTask",
      "description": "User defined ADB automation task",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "trigger": { "type": "string", "maxLength": 64 },
        "actionType": { "type": "string", "maxLength": 64 },
        "targetDevice": { "type": "string", "maxLength": 128 },
        "isEnabled": { "type": "boolean" },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/userProfile" },
      "description": "User profile collection"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/automationTask" },
      "description": "User specific automation tasks"
    }
  }
}
